schema {
  query: Query
  mutation: Mutation
}

enum ContractType {
  CDI
  CDD
  FREELANCE
  INTERIM
  STAGE
  ALTERNANCE
  VIE
}

enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFER_MADE
  ACCEPTED
  REJECTED
  WITHDRAWN
}

type Company {
  id: ID!
  userId: ID!
  name: String!
  siret: String
  description: String
  website: String
  sector: String
  country: String
  city: String
  logoUrl: String
  contactEmail: String
  contactPhone: String
  createdAt: String
  updatedAt: String
}

type Candidate {
  id: ID!
  userId: ID!
  firstName: String!
  lastName: String!
  phone: String
  city: String
  country: String
  jobTitle: String
  summary: String
  cvUrl: String
  linkedinUrl: String
  portfolioUrl: String
  birthDate: String
  openToRemote: Boolean
  openToRelocation: Boolean
  createdAt: String
  updatedAt: String
}

type JobOffer {
  id: ID!
  companyId: ID!
  companyName: String
  title: String!
  description: String
  jobCategory: String
  specialty: String
  contractType: ContractType!
  remote: Boolean
  country: String
  region: String
  department: String
  city: String
  salaryMin: Float
  salaryMax: Float
  startDate: String
  expiresAt: String
  active: Boolean
  createdAt: String
  updatedAt: String
}

type Application {
  id: ID!
  jobOfferId: ID!
  candidateId: ID!
  candidateEmail: String
  companyEmail: String
  jobTitle: String
  companyId: ID
  coverLetter: String
  cvUrl: String
  status: ApplicationStatus!
  submittedAt: String
  updatedAt: String
}

input CreateCompanyInput {
  userId: ID!
  name: String!
  contactEmail: String
}

input CreateCandidateInput {
  userId: ID!
  firstName: String!
  lastName: String!
}

input CreateJobOfferInput {
  companyId: ID!
  title: String!
  contractType: ContractType!
  description: String
  city: String
  country: String
  remote: Boolean
}

input ApplyToJobInput {
  jobOfferId: ID!
  candidateId: ID!
  coverLetter: String
  cvUrl: String
}

# --- Pagination + filtres ---

input PageInput {
  page: Int! = 0
  size: Int! = 20
}

input JobOfferFilter {
  q: String
  companyId: ID
  contractTypes: [ContractType!]
  remoteOnly: Boolean
  country: String
  region: String
  city: String
  active: Boolean = true
  salaryMinGte: Float
  salaryMaxLte: Float
}

enum JobOfferSortField {
  CREATED_AT
  UPDATED_AT
  SALARY_MIN
  SALARY_MAX
  EXPIRES_AT
  TITLE
}

enum SortDirection {
  ASC
  DESC
}

input JobOfferSort {
  field: JobOfferSortField! = CREATED_AT
  direction: SortDirection! = DESC
}

type PageInfo {
  page: Int!
  size: Int!
  totalElements: Int!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

type JobOfferPage {
  content: [JobOffer!]!
  pageInfo: PageInfo!
}

type Query {
  companyById(id: ID!): Company
  candidateById(id: ID!): Candidate
  jobOfferById(id: ID!): JobOffer
  applicationsByJobOffer(jobOfferId: ID!): [Application!]!
  applicationsByCandidate(candidateId: ID!): [Application!]!

  # Nouvelle query paginée
  searchJobOffers(
    filter: JobOfferFilter
    page: PageInput
    sort: JobOfferSort
  ): JobOfferPage!
}

type Mutation {
  createCompany(input: CreateCompanyInput!): Company!
  createCandidate(input: CreateCandidateInput!): Candidate!
  createJobOffer(input: CreateJobOfferInput!): JobOffer!
  applyToJob(input: ApplyToJobInput!): Application!
  updateApplicationStatus(applicationId: ID!, status: ApplicationStatus!): Application!
}
